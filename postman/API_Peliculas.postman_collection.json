      "name": "01 - Salud e inicio de ejecución",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('run_id', Date.now().toString() + Math.random().toString(36).slice(2, 8));",
              "pm.collectionVariables.unset('genero_id');",
              "pm.collectionVariables.unset('director_id');",
              "pm.collectionVariables.unset('productora_id');",
              "pm.collectionVariables.unset('tipo_id');",
              "pm.collectionVariables.unset('media_id');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('SQLite disponible', () => pm.expect(pm.response.json().base_datos).to.eql('SQLite'));"
            ]
          }
        }
      ]
    },
